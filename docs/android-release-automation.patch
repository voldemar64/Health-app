             apps/android/app/build/reports/androidTests/
             apps/android/app/build/outputs/androidTest-results/
           retention-days: 7
+
+  release:
+    name: Prepare Android release draft
+    needs: [build, device-tests]
+    if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      actions: read
+    defaults:
+      run:
+        working-directory: .
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - name: Download APK from this CI run
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: gh run download "$GITHUB_RUN_ID" --repo "$GITHUB_REPOSITORY" --name health-app-debug --dir release-input
+      - name: Prepare a new version draft
+        env:
+          GH_TOKEN: ${{ github.token }}
